      "student_name": "Rithvi",
      "subject": "Mathematics",
      "question": "When a quadratic equation has no real roots, what should I write in the exam besides 'discriminant is negative'?",
      "status": "Resolved",
      "created_at": "2026-11-02T09:00:00",
      "answers": [
        {
          "id": "a2",
          "author_id": "u5",
          "author_name": "Ms. Iyer",
          "explanation": "Compute D = b\u00b2 \u2212 4ac and show the substitution. If D < 0, state that the roots are not real. If the syllabus asks for complex roots, write them as (\u2212b \u00b1 i\u221a|D|) / 2a. Also mention that the parabola does not cross the x-axis.",
          "points_awarded": 25,
          "verified": true,
          "upvotes": [
            "u2"
          ],
          "author_username": "ms-iyer"
        }
      ],
      "student_username": "rithvi_11"
