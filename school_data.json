      "subject": "Physics",
      "question": "Why does a concave mirror form a real image when the object is beyond the focus, and a virtual image when it is between the focus and the mirror?",
      "status": "Resolved",
      "created_at": "2026-11-02T15:53:12",
      "answers": [
        {
          "id": "a3",
          "author_id": "u2",
          "author_name": "Ananya Shah",
          "explanation": "Beyond the focus, reflected rays actually meet in front of the mirror, so the image is real and can be caught on a screen. Between the focus and the mirror, the reflected rays only appear to meet behind the mirror, so the image is virtual.",
          "points_awarded": 25,
          "verified": true,
          "upvotes": [],
          "author_username": "ananya.s1"
        }
      ],
      "student_username": "kabir-m2"
